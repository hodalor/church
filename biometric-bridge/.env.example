BIOMETRIC_BRIDGE_PORT=4113
BIOMETRIC_BRIDGE_HOST=127.0.0.1
BIOMETRIC_BRIDGE_MODE=mock
BIOMETRIC_BRIDGE_ALLOWED_ORIGIN=http://localhost:3000
BIOMETRIC_BRIDGE_PROVIDER=ZKTeco
BIOMETRIC_BRIDGE_DEVICE_MODEL=SLK20R

# Shell mode lets you call your own SDK wrapper script.
# The bridge sends JSON to stdin and expects JSON on stdout.
# Example:
# BIOMETRIC_BRIDGE_MODE=shell
# BIOMETRIC_BRIDGE_ENROLL_COMMAND=python adapters\\zkteco_adapter.py enroll
# BIOMETRIC_BRIDGE_IDENTIFY_COMMAND=python adapters\\zkteco_adapter.py identify
# BIOMETRIC_BRIDGE_HEALTH_COMMAND=python adapters\\zkteco_adapter.py health

# Optional mock values used in BIOMETRIC_BRIDGE_MODE=mock
MOCK_IDENTIFY_MEMBER_ID=
MOCK_IDENTIFY_TEMPLATE_ID=
