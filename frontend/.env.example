# API
# Base URL for the backend REST API consumed by the React dashboard.
REACT_APP_API_BASE_URL=http://localhost:5000/api/v1

# Supabase (for direct browser uploads)
# Supabase project URL used by browser-side upload flows.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
# Public anon key used by the frontend for direct uploads where enabled.
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Storage buckets
# Bucket used for member profile photos.
REACT_APP_SUPABASE_BUCKET_MEMBERS=member-photos
# Bucket used for church media assets.
REACT_APP_SUPABASE_BUCKET_MEDIA=church-media
# Bucket used for generated and uploaded documents.
REACT_APP_SUPABASE_BUCKET_DOCUMENTS=documents
