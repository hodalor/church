# Server
# Port the Express API listens on locally or in containers.
PORT=5000
# Runtime mode used for logging, middleware behavior, and optimizations.
NODE_ENV=development

# Database
# MongoDB connection string for the primary application database.
MONGODB_URI=mongodb://localhost:27017/prynova

# JWT Authentication
# Secret used to sign short-lived access tokens. Use at least 32 random characters.
JWT_SECRET=your_jwt_secret_minimum_32_chars
# Secret used to sign long-lived refresh tokens. Use a different 32+ character value.
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_chars
# Access token lifetime.
JWT_EXPIRES_IN=15m
# Refresh token lifetime.
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Seed Account
# Tenant ID created or used for the default platform super admin account.
SUPER_ADMIN_TENANT_ID=prynova-master
# Username for the seeded super admin account.
SUPER_ADMIN_USERNAME=superadmin
# PIN for the seeded super admin account. Change this immediately outside local development.
SUPER_ADMIN_PIN=123456

# Frontend Origin
# Allowed frontend origin for browser requests during local development.
CLIENT_ORIGIN=http://localhost:3000

# Supabase Storage
# Supabase project URL used for file and media storage.
SUPABASE_URL=https://your-project.supabase.co
# Public anon key used for standard Supabase access.
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key used by the backend for privileged storage operations.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SMS Provider (Twilio) - optional
# Twilio account SID for SMS delivery features.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio auth token paired with the account SID.
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Default sender number for outbound SMS messages.
TWILIO_FROM_NUMBER=+1234567890

# WhatsApp Provider - optional
# WhatsApp provider name used by the messaging integration.
WHATSAPP_PROVIDER=twilio
# Provider API key or token for WhatsApp messaging.
WHATSAPP_API_KEY=your_whatsapp_api_key

# Email Provider (SMTP) - optional
# SMTP host used for email notifications.
SMTP_HOST=smtp.gmail.com
# SMTP port used by the configured mail server.
SMTP_PORT=587
# SMTP username or email address.
SMTP_USER=your_email@gmail.com
# SMTP password or app password for the configured account.
SMTP_PASS=your_app_password
# Default From address for outbound email.
SMTP_FROM=noreply@yourchurch.com

# Firebase Cloud Messaging - optional
# Server key used for Firebase push notifications.
FCM_SERVER_KEY=your_firebase_server_key

# Anthropic AI Assistant - optional
# API key used to enable AI Pastor Assistant features.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
# Feature flag to enable or disable AI-powered features.
AI_FEATURES_ENABLED=true

# Rate Limiting
# Maximum number of login attempts allowed within the configured window.
LOGIN_RATE_LIMIT_MAX=10
# Login rate limit window in milliseconds.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
