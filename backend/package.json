{
  "name": "prynova-backend",
  "version": "1.0.0",
  "description": "Production-grade Express backend scaffold for the Prynova Church Management System.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "keywords": [
    "express",
    "mongodb",
    "multi-tenant",
    "church-management",
    "prynova"
  ],
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@supabase/supabase-js": "^2.106.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.0",
    "pdfkit": "^0.18.0",
    "pino": "^9.9.4",
    "pino-pretty": "^13.1.1",
    "qrcode": "^1.5.4",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@jest/globals": "^30.1.3",
    "cross-env": "^10.0.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.14"
    ,
    "supertest": "^7.1.4"
  }
